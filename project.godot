; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ShapeShift: Neon Gauntlet"
run/main_scene="res://scenes/boot_splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.231373, 0.533333, 0.698039, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/branding/splash-flat-4x3.png"
boot_splash/minimum_display_time=800

[audio]

default_bus_layout="res://audio/default_bus_layout.tres"

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=720
window/stretch/mode="canvas_items"

